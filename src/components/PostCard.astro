---
import { getPostColumn, type BlogPost } from '../lib/posts';
import { formatDate } from '../lib/posts';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const column = getPostColumn(post);
---

<article class="post-card">
  <a href={`/blog/${post.id}/`} class="post-card-link pixel-press">
    <div class="post-card-top">
      <p class="post-meta">{formatDate(post.data.pubDate)}</p>
      <span class:list={['column-badge', `accent-${column.accent}`]}>{column.name}</span>
    </div>
    <h2>{post.data.title}</h2>
    <p>{post.data.description}</p>
    {
      post.data.tags.length > 0 && (
        <ul class="tag-list" aria-label="文章标签">
          {post.data.tags.map((tag) => (
            <li>#{tag}</li>
          ))}
        </ul>
      )
    }
  </a>
</article>
