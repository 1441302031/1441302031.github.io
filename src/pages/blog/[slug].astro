---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPostColumn, getPublishedPosts, type BlogPost } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const column = getPostColumn(post);
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article-shell">
    <header class="article-header pixel-panel">
      <a class="back-link pixel-press" href="/blog/">返回日志列表</a>
      <div class="article-meta-row">
        <p class="post-meta">{formatDate(post.data.pubDate)}</p>
        <a class:list={['column-badge', 'pixel-press', `accent-${column.accent}`]} href={`/columns/${column.slug}/`}>
          {column.name}
        </a>
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      {
        post.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="文章标签">
            {post.data.tags.map((tag) => (
              <li>#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
