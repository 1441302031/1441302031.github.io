---
import ColumnCard from '../components/ColumnCard.astro';
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { columns, getColumnPostCount } from '../lib/columns';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);
---

<BaseLayout title="Abner.FarmDevLog">
  <section class="hero-section">
    <div class="hero-copy pixel-panel">
      <p class="eyebrow">New Game Dev Journal</p>
      <h1>在像素村庄里整理游戏工程知识。</h1>
      <p class="intro-text">
        这里是一片给 Unity、小游戏、性能优化、Editor 工具、AI Workflow 和图形学笔记准备的知识农田。
      </p>
      <div class="action-row">
        <a class="button primary pixel-press" href="/columns/">进入专栏</a>
        <a class="button ghost pixel-press" href="/blog/">查看全部文章</a>
      </div>
    </div>
    <aside class="farm-board pixel-panel" aria-label="博客状态">
      <div class="pixel-scene" aria-hidden="true">
        <span class="sun"></span>
        <span class="barn"></span>
        <span class="field-row row-a"></span>
        <span class="field-row row-b"></span>
        <span class="field-row row-c"></span>
      </div>
      <dl class="farm-stats">
        <div>
          <dt>文章</dt>
          <dd>{posts.length}</dd>
        </div>
        <div>
          <dt>专栏</dt>
          <dd>{columns.length}</dd>
        </div>
        <div>
          <dt>主题</dt>
          <dd>游戏技术</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="content-section">
    <div class="section-heading">
      <p class="eyebrow">Knowledge Fields</p>
      <h2>专栏入口</h2>
    </div>
    <div class="column-grid">
      {
        columns.map((column) => (
          <ColumnCard column={column} count={getColumnPostCount(posts, column.slug)} />
        ))
      }
    </div>
  </section>

  <section class="content-section">
    <div class="section-heading">
      <p class="eyebrow">Recent Notes</p>
      <h2>最新日志</h2>
    </div>
    <div class="post-grid">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
