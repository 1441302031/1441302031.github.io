---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const latestPosts = posts.slice(0, 3);
---

<BaseLayout title="Abner.DevLog">
  <section class="intro-section">
    <div class="intro-copy">
      <p class="eyebrow">Game Dev Notes</p>
      <h1>Unity / MiniGame / Performance / Tools</h1>
      <p class="intro-text">记录游戏工程、性能优化、工具链与 AI 辅助开发实践。</p>
      <div class="action-row">
        <a class="button primary" href="/blog/">读取日志</a>
        <a class="button ghost" href="/about/">工程档案</a>
      </div>
    </div>

    <aside class="terminal-panel" aria-label="开发日志启动状态">
      <div class="terminal-titlebar">
        <span></span>
        <span></span>
        <span></span>
        <strong>devlog.boot</strong>
      </div>
      <pre><code>&gt; booting devlog...
&gt; loading unity tools...
&gt; profiling minigame runtime...
&gt; indexing performance notes...
&gt; ready.</code></pre>
    </aside>
  </section>

  <section class="metrics-strip" aria-label="博客状态">
    <div>
      <span>POSTS</span>
      <strong>{posts.length}</strong>
    </div>
    <div>
      <span>STACK</span>
      <strong>Astro</strong>
    </div>
    <div>
      <span>FOCUS</span>
      <strong>Unity / Tools</strong>
    </div>
  </section>

  <section class="content-section">
    <div class="section-heading">
      <p class="eyebrow">Latest Logs</p>
      <h2>最近写入</h2>
    </div>
    <div class="post-grid">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
