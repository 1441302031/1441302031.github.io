---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '1441302031 的个人博客，记录技术学习、项目实践与日常思考。' } = Astro.props;
const siteName = '1441302031 的博客';
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: '首页' },
  { href: '/blog/', label: '文章' },
  { href: '/about/', label: '关于' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="返回首页">
        <span class="brand-mark" aria-hidden="true">14</span>
        <span>{siteName}</span>
      </a>
      <nav class="site-nav" aria-label="主导航">
        {
          navItems.map((item) => {
            const isActive =
              item.href === '/'
                ? currentPath === '/'
                : currentPath === item.href || currentPath.startsWith(item.href);
            return (
              <a class:list={['nav-link', { active: isActive }]} href={item.href}>
                {item.label}
              </a>
            );
          })
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} 1441302031. Built with Astro.</p>
    </footer>
  </body>
</html>
